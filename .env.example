# Copy this file to .env and fill in real values
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Turso (libsql) database — create at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Default admin account (created on first run)
ADMIN_EMAIL=admin@luckiest.ai
ADMIN_PASSWORD=ChangeMe!2026

# Anthropic Claude API key (required for AI replies)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-7

# Meta / Facebook / Instagram (one app handles both)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=luckiest-ai-verify

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=luckiest-ai-whatsapp

# Public base URL for webhooks (use ngrok in dev: https://xxxx.ngrok.io)
PUBLIC_URL=http://localhost:3000
